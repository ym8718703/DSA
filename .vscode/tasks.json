{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CPP",
      "type": "shell",
      "command": "g++ -std=c++17 -O2 -Wall \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}\" && \"${fileDirname}\\${fileBasenameNoExtension}\" < \"${workspaceFolder}\\input.txt\" > \"${workspaceFolder}\\output.txt\"",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": { "kind": "build", "isDefPault": true },
      "problemMatcher": ["$gcc"],
      "presentation": {"reveal": "silent", "panel": "shared"
      }
    }
  ]
}